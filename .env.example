# Firebase-Konfiguration (siehe docs/firebase-setup.md).
# Kopiere diese Datei nach .env.local und trage die Werte aus der Firebase-Konsole ein:
# Projekteinstellungen → Allgemein → Meine Apps → Web-App → SDK-Konfiguration.
# Ohne diese Werte läuft die App ohne Anmeldung (Fortschritt nur im Browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
